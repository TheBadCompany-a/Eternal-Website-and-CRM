# Copy this file to .env.local (already gitignored via the *.local rule)
# and fill in your CRM's Supabase project values: Project Settings -> API.
#
# The anon/public key is safe to expose in a browser bundle by design —
# it's meant to be public; Row Level Security (see supabase/003_rls_policies.sql)
# is what actually restricts access, not secrecy of this key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
